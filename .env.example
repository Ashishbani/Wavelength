# --- Server configuration ---

# Port to listen on (a host may set this automatically).
PORT=3001

# REQUIRED: a strong, unique secret for signing login tokens.
# The server refuses to start without it. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Set to 'true' when the app is served over HTTPS (deploy / tunnel / domain),
# so the auth cookie gets the Secure flag. Leave unset for local http dev.
COOKIE_SECURE=

# Optional: restrict CORS to a specific client origin. If unset, the server
# reflects the request origin (fine for single-origin deploys and tunnels).
# CLIENT_ORIGIN=https://your-domain.example

# --- Database ---
# Persistence uses libSQL. For a hosted database (Turso), set both of these —
# then accounts/playlists/history survive restarts and redeploys on any host:
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=your-turso-token
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# If DATABASE_URL is unset, the server uses a local SQLite file at DB_PATH.
# Fine for local dev; on an ephemeral host this resets on every restart.
DB_PATH=wavelength.sqlite

# --- Email (forgot-password codes) ---
# Preferred: Brevo (https://brevo.com — free 300/day, delivers to ANY inbox
# once you verify a single sender address; no domain needed).
#   1. Sign up → Senders & IPs → add your sender email → click their
#      confirmation link.
#   2. SMTP & API → generate an API key.
#   3. Set BREVO_API_KEY and MAIL_FROM="Wavelength <that-sender@email>".
BREVO_API_KEY=
# Alternative: Resend (https://resend.com) — needs a VERIFIED DOMAIN to reach
# recipients other than the account owner. Used only when BREVO_API_KEY is
# unset.
RESEND_API_KEY=
# The sender identity for either provider, e.g. "Wavelength <noreply@you.com>"
MAIL_FROM=

