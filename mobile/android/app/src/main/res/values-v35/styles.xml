<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 forces edge-to-edge for targetSdk 35, which draws the web
         content underneath the status and navigation bars. Opt out so the app
         is laid out between them (classic behavior), with bars tinted to match
         the app background. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">#080813</item>
        <item name="android:navigationBarColor">#080813</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
